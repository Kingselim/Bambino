package tn.esprit.bambinou.Service;

import org.apache.pdfbox.pdmodel.PDDocument;
import org.apache.pdfbox.pdmodel.PDPage;
import org.apache.pdfbox.pdmodel.PDPageContentStream;
import org.apache.pdfbox.pdmodel.font.PDType1Font;
import org.springframework.stereotype.Service;

import java.io.IOException;
import java.nio.file.Files;
import java.nio.file.Paths;
import java.util.Arrays;
import java.util.stream.Collectors;

@Service
public class PdfService {

    public String createSummaryPdf(String content, Long appointmentId) throws IOException {

        // Clean the content before generating the PDF
        String cleanedContent = cleanTranscription(content);

        Files.createDirectories(Paths.get("summaries"));
        String fileName = "meeting-summary-" + appointmentId + ".pdf";
        String outputPath = "summaries/" + fileName;

        try (PDDocument document = new PDDocument()) {
            PDPage page = new PDPage();
            document.addPage(page);

            try (PDPageContentStream contentStream = new PDPageContentStream(document, page)) {
                contentStream.beginText();
                contentStream.setFont(PDType1Font.HELVETICA_BOLD, 12);
                contentStream.newLineAtOffset(50, 700);
                contentStream.showText("Meeting Summary");
                contentStream.endText();

                contentStream.beginText();
                contentStream.setFont(PDType1Font.HELVETICA, 12);
                contentStream.newLineAtOffset(50, 650);
                contentStream.setLeading(14.5f);

                // Split the cleaned content into words
                String[] words = cleanedContent.split("\\s+");
                StringBuilder lineBuilder = new StringBuilder();
                int wordCount = 0;

                for (String word : words) {
                    lineBuilder.append(word).append(" ");
                    wordCount++;

                    if (wordCount == 20) {  // When 20 words are added, write the line
                        contentStream.showText(lineBuilder.toString().trim());
                        contentStream.newLine();
                        lineBuilder.setLength(0);
                        wordCount = 0;
                    }
                }

                // Write remaining words if any
                if (lineBuilder.length() > 0) {
                    contentStream.showText(lineBuilder.toString().trim());
                    contentStream.newLine();
                }

                contentStream.endText();
            }

            document.save(outputPath);
        }

        return outputPath;
    }

    public String cleanTranscription(String content) {
        return Arrays.stream(content.split("\n"))
                .filter(line -> !line.contains("UserWarning"))
                .filter(line -> !line.contains("Received audio file"))
                .filter(line -> !line.matches("^[a-zA-Z]:\\\\.*"))  // Filters Windows paths
                .collect(Collectors.joining("\n"));
    }
}
